{
  "expo": {
    "name": "MyClub",
    "slug": "myclub",
    "scheme": "myclub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.myclub.mobile"
    },
    "android": {
      "package": "app.myclub.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-secure-store"]
  }
}
